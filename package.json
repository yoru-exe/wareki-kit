{
  "name": "wareki-kit",
  "version": "0.4.0",
  "description": "Convert between Gregorian dates and Japanese era dates (和暦: 令和, 平成, 昭和, 大正, 明治). Zero dependencies, with TypeScript types.",
  "keywords": [
    "wareki",
    "japanese-era",
    "japanese-calendar",
    "nengo",
    "reiwa",
    "heisei",
    "showa",
    "date",
    "converter",
    "和暦",
    "元号",
    "kanji-numerals",
    "cli",
    "nendo",
    "fiscal-year",
    "timezone",
    "commonjs"
  ],
  "license": "MIT",
  "author": "yoru-exe",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "bin"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build-cjs.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoru-exe/wareki-kit.git"
  },
  "bugs": {
    "url": "https://github.com/yoru-exe/wareki-kit/issues"
  },
  "homepage": "https://github.com/yoru-exe/wareki-kit#readme",
  "bin": {
    "wareki": "./bin/wareki.js"
  }
}
